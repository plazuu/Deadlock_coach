# Copy to .env and fill in. All optional except LIMPET_STEAM_ID.
# Any Steam ID form works: account id, SteamID64, [U:1:...], STEAM_1:..., or a
# steamcommunity.com/profiles/ URL.
LIMPET_STEAM_ID=

# deadlock-api.com key (optional — roughly doubles rate limits)
LIMPET_DEADLOCK_API_KEY=

# Anthropic key (optional — falls back to ANTHROPIC_API_KEY / `ant auth` profile)
LIMPET_ANTHROPIC_API_KEY=

# Overrides (optional)
# LIMPET_MODEL=claude-opus-5
# LIMPET_POLL_INTERVAL_MINUTES=10
